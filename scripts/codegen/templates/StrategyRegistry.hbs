import { InumakiProgress } from 'inumaki';
import { Provider } from '@types';
import { BaseStrategy } from '@base';
{{imports}}

type StrategyCtor = new (progress: InumakiProgress) => BaseStrategy;

export class StrategyRegistry {
	constructor(private readonly progress: InumakiProgress) {}

	private readonly strategies: Record<Provider, StrategyCtor> = {
		{{entries}}
	};

	public getStrategy(provider: Provider): BaseStrategy {
		const StrategyClass = this.strategies[provider] ?? this.strategies[Provider.Default];
		return new StrategyClass(this.progress);
	}
}
